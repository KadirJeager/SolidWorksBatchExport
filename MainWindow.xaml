<Window x:Class="SolidWorksBatchExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toplu Sac Açınım ve Çentik Aracı" Height="450" Width="600" Background="#f4f4f4">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SolidWorks Batch Exporter" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" Grid.Row="0"/>

        <!-- Girdi Ayarları -->
        <GroupBox Header="Girdi Ayarları" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hedef Klasör:" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="0"/>
                    <TextBox x:Name="txtFolderPath" Grid.Column="1" VerticalAlignment="Center" IsReadOnly="True" Background="#eee"/>
                    <Button x:Name="btnBrowse" Content="Gözat..." Width="75" Margin="10,0,0,0" Grid.Column="2" Click="btnBrowse_Click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Çentik ve Çıktı Ayarları -->
        <GroupBox Header="İşlem Ayarları" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="chkEnableNotch" Content="Büküm Uçlarına Çentik Eklensin" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Çentik Yarıçapı (mm):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtNotchRadius" Text="1.5" Width="50" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <CheckBox x:Name="chkExportBendLines" Content="Büküm Çizgilerini Dışa Aktar" IsChecked="True" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- Log Ekranı -->
        <GroupBox Header="İşlem Kayıtları (Logs)" Grid.Row="3" Margin="0,0,0,10">
            <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#333" Foreground="#00FF00" FontFamily="Consolas" Padding="5"/>
        </GroupBox>

        <!-- Başlat Butonu -->
        <Button x:Name="btnStart" Content="İşlemi Başlat" Height="40" Grid.Row="4" FontSize="14" FontWeight="Bold" Background="#007ACC" Foreground="White" Click="btnStart_Click"/>
    </Grid>
</Window>
