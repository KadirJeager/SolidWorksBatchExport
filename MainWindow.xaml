<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SolidWorksBatchExport.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Toplu Sac Açınım ve Çentik Aracı" Height="880" Width="760" MinHeight="520" MinWidth="740" WindowStartupLocation="CenterScreen" Background="#F0F2F5" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
      <Style x:Key="{x:Type GroupBox}" TargetType="{x:Type GroupBox}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupBox}">
              <Border Background="#FFFFFFFF" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Control.Padding}">
                <DockPanel>
                  <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.Foreground="#374151" Margin="0,0,0,10" />
                  <ContentPresenter />
                </DockPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="Foreground" Value="#1B1F23" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.76" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="2,0,0,14">
        <TextBlock Text="Toplu Sac Açınım ve Çentik Aracı" FontSize="20" FontWeight="SemiBold" Foreground="#1B1F23" />
        <TextBlock Text="SolidWorks montajlarından toplu DXF/DWG açınım, çentik ve kesim listesi raporu" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>
      <GroupBox Header="Kaynak Klasör" Grid.Row="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Name="txtFolderPath" Grid.Column="0" VerticalAlignment="Center" IsReadOnly="True" Background="#F3F4F6" ToolTip="İşlenecek SolidWorks dosyalarının bulunduğu klasör. Alt klasörler de taranır." />
          <Button Name="btnBrowse" Content="Gözat..." Margin="10,0,0,0" Grid.Column="1" Click="btnBrowse_Click" />
        </Grid>
      </GroupBox>
      <GroupBox Header="İşlenecek Dosyalar" Grid.Row="2" Padding="14,14,14,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Name="btnSelectAll" Content="Tümünü Seç" Margin="0,0,8,0" Click="btnSelectAll_Click" />
            <Button Name="btnSelectNone" Content="Seçimi Kaldır" Margin="0,0,8,0" Click="btnSelectNone_Click" />
            <Button Name="btnRescan" Content="Yeniden Tara" Click="btnRescan_Click" />
            <TextBlock Text="Filtre:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox Name="cmbFileFilter" Width="100" VerticalAlignment="Center" ToolTip="Listeyi dosya türüne göre filtreler: yalnız parça dosyaları (.SLDPRT), yalnız montaj dosyaları (.SLDASM) veya tümü." SelectionChanged="cmbFileFilter_Changed">
              <ComboBoxItem Content="Tümü" Tag="All" IsSelected="True" />
              <ComboBoxItem Content="Parça" Tag="Part" />
              <ComboBoxItem Content="Montaj" Tag="Assembly" />
            </ComboBox>
            <TextBlock Name="txtFileCount" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>
          <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="4">
            <ScrollViewer Height="130" VerticalScrollBarVisibility="Auto">
              <ItemsControl Name="itemsFiles">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Margin="4,3" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding DisplayName}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </GroupBox>
      <GroupBox Header="Çentik Ayarları" Grid.Row="3">
        <StackPanel Orientation="Vertical">
          <CheckBox Name="chkEnableNotch" Content="Büküm uçlarına çentik aç" IsChecked="True" VerticalAlignment="Center" ToolTip="Açınımda, her büküm çizgisinin sac kenarına ulaştığı noktaya yarım daire çentik keser. Çentikler bükümhanede büküm hattını hizalamak için referans olarak kullanılır." />
          <StackPanel Orientation="Horizontal" Margin="22,10,0,0">
            <RadioButton Name="rdoNotchAuto" GroupName="NotchDia" IsChecked="True" VerticalAlignment="Center" Content="Çapı sac kalınlığına göre otomatik seç  (kalınlık &lt; 4 mm → Ø4,  ≥ 4 mm → Ø6)" ToolTip="Önerilen seçenek. Sac kalınlığı her parçanın modelinden okunur: 4 mm'den ince saclara Ø4 mm, 4 mm ve daha kalın saclara Ø6 mm çentik açılır." Checked="NotchMode_Changed" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
            <RadioButton Name="rdoNotchCustom" GroupName="NotchDia" VerticalAlignment="Center" Content="Sabit çap kullan (mm):" ToolTip="Sac kalınlığına bakılmaz; bütün parçalarda burada girilen çap kullanılır." Checked="NotchMode_Changed" />
            <TextBox Name="txtNotchDiameter" Text="3.0" Width="56" VerticalAlignment="Center" Margin="8,0,0,0" IsEnabled="False" ToolTip="Çentik çapı, milimetre. Örnek: 4 veya 4.5" />
          </StackPanel>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="Çıktı Seçenekleri" Grid.Row="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="Çıktı formatı:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
            <CheckBox Name="chkExportDXF" Content="DXF" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Açınımı DXF formatında dışa aktarır (lazer/plazma tezgahlarının standart formatı)." />
            <CheckBox Name="chkExportDWG" Content="DWG" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Açınımı DWG formatında dışa aktarır (AutoCAD formatı)." />
            <CheckBox Name="chkHideBendLines" Content="Büküm çizgilerini gizle" IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Çıktıda büküm çizgileri yer almaz; yalnız kesim konturu ve çentikler kalır." />
            <CheckBox Name="chkAllConfigs" Content="Tüm konfigürasyonları işle" IsChecked="False" VerticalAlignment="Center" ToolTip="Parçanın her konfigürasyonu ayrı bir çıktı üretir; dosya adına konfigürasyon adı eklenir (örn. Parça_Konfig1). Kapalıyken yalnız aktif konfigürasyon işlenir." />
          </StackPanel>
          <CheckBox Name="chkUseDrawingTemplate" Content="Teknik resim şablonu kullan" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Row="1" Grid.Column="0" ToolTip="Açınım, seçilen teknik resim şablonu (.drwdot) üzerinden 1:1 ölçekte dışa aktarılır. Şablon seçilmezse SolidWorks'ün varsayılan şablonu kullanılır." Click="chkUseDrawingTemplate_Click" />
          <TextBox Name="txtTemplatePath" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="False" />
          <Button Name="btnBrowseTemplate" Content="Şablon Seç..." Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" Click="btnBrowseTemplate_Click" />
          <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock Text="Çıktı konumu:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
            <ComboBox Name="cmbOutputPlacement" Width="250" VerticalAlignment="Center" ToolTip="DXF/DWG dosyalarının kaydedileceği yer:&#xA;• Alt montaj klasörlerine — her parça, ait olduğu montajın kendi klasörüne kaydedilir.&#xA;• Tek klasörde topla — tüm çıktılar, adı ana montajdan türetilen tek klasöre gider (örn. '1234-FİRMA-süspansiyon' → '1234-FİRMA-KESİM').&#xA;• Her ikisine — çıktılar iki konuma birden yazılır.&#xA;Kesim listesi raporu ve önizleme resimleri her durumda merkez klasöre kaydedilir.">
              <ComboBoxItem Content="Alt montaj klasörlerine" Tag="OwnFolders" IsSelected="True" />
              <ComboBoxItem Content="Tek klasörde topla (…-KESİM)" Tag="Central" />
              <ComboBoxItem Content="Her ikisine" Tag="Both" />
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock Text="Alt klasör düzeni:" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Çıktı klasörünün içinde malzemeye ve/veya kalınlığa göre alt klasörler oluşturur (örn. 4mm\, S235\4mm\)." />
            <ComboBox Name="cmbFolderGrouping" Width="150" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Çıktı klasörünün içinde malzemeye ve/veya kalınlığa göre alt klasörler oluşturur (örn. 4mm\, S235\4mm\).">
              <ComboBoxItem Content="Alt klasör yok (düz)" Tag="None" IsSelected="True" />
              <ComboBoxItem Content="Malzemeye göre" Tag="Material" />
              <ComboBoxItem Content="Kalınlığa göre" Tag="Thickness" />
              <ComboBoxItem Content="Malzeme → Kalınlık" Tag="Material_Thickness" />
              <ComboBoxItem Content="Kalınlık → Malzeme" Tag="Thickness_Material" />
            </ComboBox>
            <TextBlock Text="Dosya adı şablonu:" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="İleri düzey kullanım: dosya adını değişkenlerle serbestçe kurgulayın." />
            <TextBox Name="txtFileNamePattern" Text="%DA%" Width="130" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="İleri düzey: dosya adı bu şablona göre oluşturulur. Değişkenler:&#xA;%DA% = parça dosya adı&#xA;%MA% = malzeme&#xA;%KA% = sac kalınlığı&#xA;%AD% = montajdaki adet&#xA;%KO% = konfigürasyon&#xA;%O1% = özel özellik&#xA;Örnek: %DA%_%KA%_%AD%adet → Bacak_4mm_4adet" TextChanged="txtFileNamePattern_TextChanged" />
            <TextBlock Text="%O1% özelliği:" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="%O1% değişkeninin okuyacağı özel özellik (custom property) adı. Örnek: Tanım, Description, Parça No" />
            <TextBox Name="txtCustomPropertyKey" Text="Tanım" Width="72" VerticalAlignment="Center" ToolTip="%O1% değişkeninin okuyacağı özel özellik (custom property) adı. Örnek: Tanım, Description, Parça No" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Dosya adına ekle:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" ToolTip="Seçilen bilgiler çıktı dosyasının adına eklenir. Aşağıdaki örnek satırı sonucu gösterir." />
              <CheckBox Name="chkNameMaterial" Content="Malzeme" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Dosya adına malzeme adını ekler (örn. Bacak_S235)." Checked="NameOption_Changed" Unchecked="NameOption_Changed" />
              <CheckBox Name="chkNameThickness" Content="Kalınlık" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Dosya adına sac kalınlığını ekler (örn. Bacak_4mm)." Checked="NameOption_Changed" Unchecked="NameOption_Changed" />
              <CheckBox Name="chkNameQty" Content="Adet" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Dosya adına parçanın montajdaki toplam adedini ekler (örn. Bacak_4adet)." Checked="NameOption_Changed" Unchecked="NameOption_Changed" />
              <CheckBox Name="chkNameConfig" Content="Konfigürasyon" VerticalAlignment="Center" ToolTip="Dosya adına aktif konfigürasyon adını ekler." Checked="NameOption_Changed" Unchecked="NameOption_Changed" />
            </StackPanel>
            <TextBlock Name="txtNamePreview" Text="Örnek çıktı: Bacak.dxf" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </GroupBox>
      <GroupBox Header="İşlem Günlüğü" Grid.Row="5">
        <TextBox Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="170" Background="#1E1E1E" Foreground="#98C379" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="8" />
      </GroupBox>
      <Button Name="btnStart" Content="Seçili Dosyaları İşle" Height="44" Grid.Row="6" Style="{StaticResource PrimaryButton}" FontSize="14" Click="btnStart_Click" />
    </Grid>
  </ScrollViewer>
</Window>
